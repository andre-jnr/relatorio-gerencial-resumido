# Copie este arquivo para .env e preencha os valores reais.
# O .env nunca vai para o GitHub (está no .gitignore).

# Conexão com o banco SISMOURA da Morada do Sol (somente leitura)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=nome_do_servidor
DB_DATABASE=nome_do_banco
DB_USER=usuario
DB_PASSWORD=senha
DB_TIMEOUT=60

# Servidor web
HOST=0.0.0.0
PORT=3005
CACHE_MINUTOS=5

# Regras de negócio
LOJA_NOME=Morada do Sol
GERENTE_NOME=Lincoln
# CFOPs das NF de transferência enviadas (separados por ;)
TRANSF_CFOPS=5.152;5.409;5.557;5.552
# Contas contábeis fora dos pagamentos (separadas por ;). A comparação ignora acentos, maiúsculas e espaços.
CONTAS_EXCLUIDAS=CONTA 1;CONTA 2

# Planilha do plano de contas (colunas PAGAMENTOS, GRUPO e PLANO DE CONTAS)
PLANILHA_CLASSIFICACAO=dados/classificacao_pagamentos.xlsx
